# Copy to backend/.env and edit. Every value has a safe default; this file only lists what you may want to change.

APP_NAME=PackLead Scraper
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite is used by default (file: backend/packlead.db). For PostgreSQL use:
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/packlead
# DATABASE_URL=

# Comma-separated origins allowed to call the API (your frontend URL(s)). Never use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where uploaded files (deleted after UPLOAD_TTL_HOURS) and generated .xlsx exports are stored
# UPLOAD_DIR=
# EXPORT_DIR=
UPLOAD_TTL_HOURS=24
MAX_UPLOAD_MB=25

# true = the API process also runs the background worker (simplest). Set false and run
# `python -m app.workers.run_worker` as a second process on hosts where you want them split.
EMBEDDED_WORKER=true

# Crawler politeness / limits
USER_AGENT=PackLeadBot/1.0 (+lead research tool; respects robots.txt)
RESPECT_ROBOTS_TXT=true
REQUEST_TIMEOUT=15
MIN_DOMAIN_DELAY=0.5
GLOBAL_CONCURRENCY=8
MAX_JOB_CONCURRENCY=10
MAX_PAGES_LIMIT=100
MAX_DEPTH_LIMIT=4
MAX_URLS_PER_JOB=5000

# Optional OCR for scanned PDFs (only works if the free Tesseract program is installed on this computer)
ENABLE_OCR=true

# DEVELOPMENT ONLY: lets the crawler reach the bundled local test site. Leave empty otherwise.
# Leads from these hosts are flagged TEST DATA and kept out of the dashboard and exports by default.
# TEST_FIXTURE_HOSTS=127.0.0.1:8099,localhost:8099
TEST_FIXTURE_HOSTS=
